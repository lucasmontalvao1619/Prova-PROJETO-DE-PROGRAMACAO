<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- o parent do Spring Boot fixa a versao de todas as bibliotecas do
         ecossistema. e por isso que as dependencias la embaixo nao precisam
         declarar <version>: as combinacoes ja foram testadas juntas -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.lucdev</groupId>
    <artifactId>orcamento</artifactId>
    <version>1.0.0</version>
    <description>API REST de orcamento pessoal em Java com Spring Boot</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- traz o Tomcat embutido e o Spring MVC: e o que faz os
             @RestController responderem as requisicoes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- JPA com Hibernate: traduz a classe Transacao em tabela do banco -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- e o que faz o @Valid e o @NotBlank funcionarem de verdade -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- gera a documentacao da API em /swagger-ui.html a partir das
             anotacoes dos controllers, sem eu escrever nada -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.17</version>
        </dependency>
        <!-- banco embutido. escolhi ele pra ninguem precisar instalar um
             servidor de banco so pra rodar o projeto -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JUnit 5, AssertJ e Mockito num pacote so. o escopo test faz
             essas bibliotecas nao irem junto no jar final -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- empacota tudo num jar que roda sozinho, com o Tomcat dentro:
                 java -jar target/orcamento-1.0.0.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
